rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each event lives at events/{eventCode}. The code is the shared secret:
    // nobody can list events, so only people who know the code can reach one.
    match /events/{code} {
      allow get, create, update: if request.auth != null && code.size() >= 8;
      allow list, delete: if false;

      match /scores/{scoreId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
